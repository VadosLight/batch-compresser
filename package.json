{
	"name": "batch-compressor",
	"version": "0.0.0",
	"license": "MIT",
	"bin": {
		"batch-compressor": "dist/tui/cli.js",
		"batch-compressor-mcp": "dist/mcp/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/tui/cli.js",
		"mcp": "node dist/mcp/cli.js",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "oxfmt --check && oxlint && npm run build && ava",
		"prepare": "lefthook install"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"execa": "^8.0.1",
		"ink": "^4.1.0",
		"ink-spinner": "^5.0.0",
		"ink-text-input": "^5.0.1",
		"meow": "^11.0.0",
		"os-locale": "^5.0.0",
		"p-limit": "^5.0.0",
		"react": "^18.2.0",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/react": "^18.0.32",
		"ava": "^5.2.0",
		"chalk": "^5.2.0",
		"ink-testing-library": "^3.0.0",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3"
	},
	"ava": {
		"files": [
			"test/**/*.test.js"
		]
	}
}
