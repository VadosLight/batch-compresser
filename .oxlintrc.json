{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "import"],
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": ["dist/**", "test/**"],
	"env": {
		"builtin": true,
		"node": true
	},
	"settings": {
		"react": {
			"version": "18.2"
		}
	},
	"rules": {
		"react/set-state-in-effect": "off"
	}
}
