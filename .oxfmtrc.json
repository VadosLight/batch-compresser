{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"semi": true,
	"singleQuote": true,
	"quoteProps": "as-needed",
	"bracketSpacing": false,
	"arrowParens": "avoid",
	"trailingComma": "all",
	"printWidth": 80,
	"sortPackageJson": false,
	"ignorePatterns": ["dist", "pnpm-lock.yaml"]
}
